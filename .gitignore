# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Virtual env
.venv/
venv/
env/
.build-venv/

# Local data — DB is regenerated on first scan; do not commit user state
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Rolling backups (created by `python main.py` before any writes).
# Keep them out of git — they're user data and are rotated by db.py.
data/*.bak.*
data/*.bak.*.partial
# One-off copies taken before a manual repair; never pruned automatically.
data/*.pre-repair-*

# OS junk
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# PyInstaller output (regenerated by `pyinstaller pyinstaller.spec`).
build/
dist/
